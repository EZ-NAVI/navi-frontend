# Copy this file to .env and fill with real values for local development
# Do NOT commit your .env file — it is ignored by .gitignore

# Backend API base URL
# Replace with your environment's API endpoint. Do NOT commit your real values.
# Example (dev): http://localhost:8000
API_BASE_URL=<YOUR_API_BASE_URL>

# WebSocket base URL (use ws:// for dev, wss:// for prod)
# Example (dev): ws://localhost:8001
WS_BASE_URL=<YOUR_WS_BASE_URL>

# Example: place any other environment variables here
#SOME_API_KEY=your_api_key_here
